{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lelac",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lelac-auth-prod",
      "database_id": "613ae1a2-81de-4323-8c3a-6ffe8a86d10d",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@corpinot.cc"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
